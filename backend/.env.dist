# This file is a "template" of which env vars need to be defined for your application
# Copy this file to .env file for development, create environment variables when deploying to production

# Application environment, dev or prod, required
NEUCORE_APP_ENV=dev

# Database connection, required
NEUCORE_DATABASE_URL=mysql://neucore:neucore@neucore_db/neucore
NEUCORE_MYSQL_VERIFY_SERVER_CERT="0" # 1 or 0, if set to 1 set a ca file below
NEUCORE_MYSQL_SSL_CA="" # /path/to/ca.pem

# Database for unit tests (not needed in production)
NEUCORE_TEST_DATABASE_URL=mysql://neucore:neucore@localhost/neucore_test
#NEUCORE_TEST_DATABASE_URL=sqlite:///:memory:
NEUCORE_TEST_MYSQL_VERIFY_SERVER_CERT=0
NEUCORE_TEST_MYSQL_SSL_CA=

# Host and port of a Memcached server.
# The timeouts below cap how long a request is stalled when the server is unreachable or unresponsive.
# Both the API rate limit and the ESI header cache fail open (the limit is bypassed respectively the
# headers are treated as not cached) and an error is logged.
# The low defaults are intentional: a healthy Memcached responds in milliseconds, while
# the atomic rate limit update is a retry loop of up to 3 attempts with multiple I/O
# operations each, so higher poll timeouts multiply the worst-case stall. Increase them
# only for a remote Memcached with high latency or unstable connectivity.
NEUCORE_MEMCACHED_SERVER=localhost:11211
# Optional time to connect in milliseconds (Neucore default is 200).
# The documented default on php.net is 1000, but actually it's 4000.
NEUCORE_MEMCACHED_CONNECT_TIMEOUT=200
# Optional time for I/O waiting in milliseconds (Neucore default is 500).
# The documented default on php.net is 1000, but actually it's 5000.
NEUCORE_MEMCACHED_POLL_TIMEOUT=500

# EVE application (create at https://developers.eveonline.com, required.
# If you use different ports for the backend and frontend make sure the callback points to the backend.
NEUCORE_EVE_CLIENT_ID=123
NEUCORE_EVE_SECRET_KEY=abc
NEUCORE_EVE_CALLBACK_URL=https://neucore.domain.tld/login-callback

# Scopes for login, separated by one space, optional
NEUCORE_EVE_SCOPES=""

# Storage for various headers from the EVE API regarding limits.
# database:  This can increase the CPU usage a lot, the default.
# apc:       Needs the PHP APCu extension. Note: CLI (cron jobs) and web requests do not share the
#            same cache and for web it is kept per PHP process. This means the number of allowed
#            requests within a time window can be higher than configured. Use memcached for exact
#            limits.
# memcached: Needs the NEUCORE_MEMCACHED_SERVER environment variable, recommended.
#            When the Memcached server is unavailable, the affected requests are passed on
#            (the ESI headers are treated as not cached) and an error is logged.
NEUCORE_ESI_HEADER_STORAGE=database

# Optional user agent for all HTTP requests, see config/settings.php for the default.
# It is strongly recommended to set this. The operator of the API may use this to contact you
# if there is a problem.
NEUCORE_USER_AGENT=""

# Set this to 1 to use the token from the user that is used to send mails for ESI requests
# that do not require authentication.
# This can result in better rate limits for the EVE API.
# See also https://developers.eveonline.com/docs/services/esi/rate-limiting/#bucket-system.
NEUCORE_USE_MAIL_TOKEN_FOR_UNAUTHENTICATED_REQUESTS=0

# Comma-separated list of allowed domains for the HTTP_ORIGIN header, optional.
# Set this if the frontend is running on a different domain/port than the backend.
NEUCORE_ALLOW_ORIGIN=http://localhost:3000

# Protect server against DNS rebinding attacks.
# Comma-separated list of allowed hosts.
# If empty, all hosts are allowed (e.g. when the HTTP server enforces host validation).
# Examples: "neucore.domain.tld,localhost,neucore_http"
NEUCORE_ALLOWED_HOSTS=

# Logs
NEUCORE_LOG_PATH="" # absolute path to the log directory or output stream, optional, defaults to /path/to/backend/var/logs
NEUCORE_LOG_ROTATION="" # optional: daily, weekly (default) or monthly
NEUCORE_LOG_FORMAT="" # optional: multiline (default), line (no stacktrace), fluentd, gelf, html, json, loggly, logstash

# Cache, optional absolute path to the cache directory, defaults to /path/to/backend/var/cache
NEUCORE_CACHE_DIR=

# Error reporting level, optional, defaults to the value of E_ALL & ~E_DEPRECATED, this needs to be a number.
NEUCORE_ERROR_REPORTING=
#NEUCORE_ERROR_REPORTING=32767 # PHP 8.1-8.3 E_ALL
#NEUCORE_ERROR_REPORTING=30719 # PHP 8.4-8.5 E_ALL

# session.cookie_secure, optional, defaults to 1
NEUCORE_SESSION_SECURE=1

# session.cookie_samesite, optional, defaults to "Strict". Set it to "Lax" if a plugin requires it.
NEUCORE_SESSION_SAME_SITE=Strict

# Comma-separated list of reverse proxy IPs that are trusted to provide X-Forwarded-For.
# If empty (default), X-Forwarded-For is ignored and the address of the direct
# connection (REMOTE_ADDR) is always used.
NEUCORE_TRUSTED_PROXIES=

# Storage for the API rate limit counters.
# apc:       Needs the PHP APCu extension, the default.
#            Note: The APCu cache is kept per PHP process, so the counters are not shared between
#            processes. The limit is therefore an upper bound per process, not an exact value.
#            Use memcached for exact limits.
# database:  This can be slow. The IP based rate limit is not active if this is chosen. This is
#            not atomic and is therefore not suitable for rate limiting with high traffic.
#            For backward compatibility, this is the fallback for "apc" if the APCu extension
#            is not available.
# memcached: Needs the NEUCORE_MEMCACHED_SERVER environment variable, recommended.
#            This updates the counter atomically, so the configured limit is respected even when
#            multiple processes handle requests in parallel. When the Memcached server is unavailable,
#            the affected requests are passed on (the rate limit is bypassed) and an error is logged.
NEUCORE_RATE_LIMIT_STORAGE=apc

# IP based Rate Limit - deactivated if one of them is 0 or empty, defaults to 0.
# Needs NEUCORE_RATE_LIMIT_STORAGE set to apc or memcached!
NEUCORE_RATE_LIMIT_MAX="0" # Maximum requests
NEUCORE_RATE_LIMIT_TIME="0" # Reset time in seconds

# Full path to the directory where plugins are stored. It's used to read the plugin.yml files.
NEUCORE_PLUGINS_INSTALL_DIR=/plugins
