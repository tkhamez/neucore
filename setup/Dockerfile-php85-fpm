FROM php:8.5-fpm-alpine

RUN apk add --no-cache \
        libmemcached-libs \
        gmp \
        libzip \
        icu-libs \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        linux-headers \
        gmp-dev \
        libzip-dev \
        icu-dev \
        libmemcached-dev

RUN docker-php-ext-install \
    pdo_mysql \
    bcmath \
    gmp \
    zip \
    intl \
    mysqli

RUN --mount=type=bind,from=ghcr.io/php/pie:bin,source=/pie,target=/usr/local/bin/pie \
    pie install --no-cache \
        apcu/apcu \
        xdebug/xdebug \
        php-memcached/php-memcached

RUN apk del .build-deps

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN mkdir -p /home/www-data/.composer && chmod 0777 /home/www-data/.composer
ENV COMPOSER_HOME /home/www-data/.composer

RUN cat <<'EOF' > /usr/local/etc/php/conf.d/docker-php-neucore.ini
memory_limit = 256M
display_errors = Off
error_log = /app/backend/var/logs/error.log
log_errors = On
apc.enable_cli = 1
xdebug.mode = develop,coverage,profile,debug,trace
xdebug.output_dir = /app/backend/var/xdebug
xdebug.start_with_request = trigger
xdebug.client_host = 172.17.0.1
xdebug.max_nesting_level = 1024
EOF

# for the cache directory
RUN addgroup www-data root
